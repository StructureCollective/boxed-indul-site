{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker/project name Cloudflare Workers Builds expects.
  "name": "boxed-indul-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static site files are served from here. The Worker's fetch handler
  // routes /api/* itself and falls back to this binding for everything else.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // D1 database for orders, blocked dates, contact messages, lunch-sale
  // events/orders, signups, and the Google Calendar connection.
  // Create with: wrangler d1 create boxed-indulgence-db
  // (or via the dashboard — see README "Go-live checklist"), then paste the
  // returned database_id below. Deploys will fail until this is a real ID.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boxed-indulgence-db",
      "database_id": "aecd26a1-6fc5-4a9e-8c4a-14f81604dc30"
    }
  ],

  // Non-secret configuration. True secrets (API keys, OAuth client secret)
  // are set separately via `wrangler secret put <NAME>` or the dashboard —
  // see README.md "Go-live checklist". GOOGLE_CLIENT_ID is not secret (only
  // the client SECRET is) so it's fine to keep here in plain vars.
  "vars": {
    "BUSINESS_NAME": "Boxed Indulgence",
    "CLIENT_NOTIFY_EMAIL": "boxedindulgenceadmin@gmail.com",
    "FROM_EMAIL": "bookings@boxedindulgence.com",

    // Custom-order deposit: percentage of the itemized order total.
    "DEPOSIT_PERCENT": "50",
    "DEPOSIT_CURRENCY": "usd",
    // Fallback deposit if an order somehow has no computed total (shouldn't
    // normally happen once the itemized form is in place).
    "DEPOSIT_MIN_CENTS": "5000",

    // Deposit link expiry: Stripe Checkout Sessions cap at 24h, so anything
    // longer is enforced at the app level (see deposit_link_expires_at in
    // schema.sql) rather than by Stripe itself.
    "DEPOSIT_LINK_EXPIRY_HOURS": "72",

    // Admin login is handled by Cloudflare Access (Zero Trust), not this
    // Worker — restrict /admin/* to these emails in the Access policy:
    //   boxedindulgenceadmin@gmail.com, admin@structurecollective.com
    // The Worker just trusts the Cf-Access-Jwt-Assertion header Access adds.

    "GOOGLE_CLIENT_ID": "414049872483-8tcdg0edkb73fvfn98r9afvs0d5hk9a7.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://boxedindulgence.com/api/admin/google/callback",

    // Stripe's publishable key (pk_test_... or pk_live_...) is safe to keep
    // in plain vars — it's meant to be embedded in client-side JS, unlike
    // STRIPE_SECRET_KEY. The Worker hands this to the browser so it can
    // initialize Stripe.js and mount the Payment/Express Checkout Elements.
    "STRIPE_PUBLISHABLE_KEY": "pk_test_51U84bQBtHxFYbPJj2MA95W0bUUPhRpRAjKpY3qCFuiKSgUdmrVuu2512IpruHl4zTNn16txUcWtHFz8uWAAWQOek007MLRfkXq",

    // From the Access application's Overview tab once it's created in the
    // Cloudflare Zero Trust dashboard (Access > Applications). Needed so
    // the Worker can verify the Cf-Access-Jwt-Assertion header itself.
    // See README.md "Setting up Cloudflare Access" for exact steps.
    "CF_ACCESS_TEAM_DOMAIN": "structurecollective.cloudflareaccess.com",
    "CF_ACCESS_AUD": "90d45ad006367af2c0aec93b1a85ba3f1372f64d2187ed5fdb283524db81da01",

    "SITE_URL": "https://boxedindulgence.com"
  },

  // Daily pull-sync from the connected Google Calendar (see scheduled() in
  // src/index.js) — 06:00 UTC ≈ 1-2am Eastern, well before any lunch-sale
  // cutoffs or same-day availability checks.
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
